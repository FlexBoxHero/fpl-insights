# SQLite (local dev without Docker) or PostgreSQL (docker compose / production)
DATABASE_URL=sqlite:///fpl_insights.db
# DATABASE_URL=postgresql+psycopg://fpl:fpl@localhost:5432/fpl_insights
# Neon (Render web): pooled URL is fine. Convert postgres:// → postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon (GitHub Actions ETL): use the *direct* host, not the -pooler host
FPL_API_BASE=https://fantasy.premierleague.com/api
CORS_ORIGINS=http://localhost:4200
# Production: CORS_ORIGINS=https://your-service.onrender.com
MODEL_VERSION=team-v1+player-v1
# Set false only if corporate SSL inspection breaks football-data downloads
HTTP_VERIFY_SSL=true
# Optional: OpenAI-compatible vision for My Team screenshot ingest
# VISION_API_KEY=
# VISION_API_BASE=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini
# Gemini (AI Studio key): use a current Flash id, not retired 2.5 names
# VISION_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# VISION_MODEL=gemini-3.5-flash-lite
