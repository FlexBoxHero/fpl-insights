FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml /app/
COPY packages/fpl_shared /app/packages/fpl_shared
COPY services/api /app/services/api
COPY services/etl /app/services/etl
COPY services/ml /app/services/ml

RUN uv pip install --system -e /app/packages/fpl_shared -e /app/services/api

ENV PYTHONPATH=/app/packages/fpl_shared/src:/app/services/api

WORKDIR /app/services/api
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
